#!/bin/bash
if [ ! -d "../web/$1" ]; then
    echo "WebApp source code web/$1 does not exist"
else
    echo "***** Building $1 WebApp"
    cd ../web/$1
    yarn
    yarn build

    # Only replace files if build succeeded and dist/ has content
    if [ ! -d "dist" ] || [ -z "$(ls -A dist 2>/dev/null)" ]; then
        echo "ERROR: Build failed or dist/ is empty. Keeping existing files."
        exit 1
    fi

    echo "***** Moving $1 WebApp into place"
    if [ ! -d "../../apps/reality2_web/priv/static/sites/$1/" ]; then
        mkdir "../../apps/reality2_web/priv/static/sites/$1/"
    fi

    rm -rf ../../apps/reality2_web/priv/static/sites/$1/*
    cp -rv dist/* ../../apps/reality2_web/priv/static/sites/$1/

    # Also sync to _build so make_runtime quick picks up changes
    BUILD_PRIV=$(ls -d ../../_build/prod/lib/reality2_web-*/priv/static/sites/$1 2>/dev/null | head -1)
    if [ -n "$BUILD_PRIV" ]; then
        echo "***** Syncing to build directory"
        rm -rf "$BUILD_PRIV"/*
        cp -r dist/* "$BUILD_PRIV"/
    fi
fi
