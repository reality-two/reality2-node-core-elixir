#!/bin/bash

# Set the environment variables
export SECRET_KEY_BASE=$(openssl rand -hex 32)
export PORT=4005
export POOLSIZE=10
export MIX_ENV=prod
export BUILD_BRANCH=main
export LOG_LEVEL=info
export PLUGINS="ai.reality2.vars, ai.reality2.geospatial, ai.reality2.pns, ai.reality2.backup, ai.reality2.rustdemo, ai.reality2.transnet, ai.reality2.versioncontrol"

# The autostart directory is assumed to be in the same folder as where Reality2-Node is run.
# To change it, set AUTOSTART to the desired path:
# export AUTOSTART="/path/to/autostart"

# A Reality2 node is unlocked by default. To lock it:
# export LOCKED="true"    # No Sentants or Swarms may be created or deleted after autostart
# export LOCKED="remote"  # Only local API commands can create/delete Swarms or Sentants
export LOCKED="remote"

# Change to given directory, or to the script's directory if not specified
if [ -n "$1" ]; then
    cd "$1"
else
    cd "$(dirname "$0")"
fi

# Create the mnesia directory structure if it doesn't exist
mkdir -p ".mnesia/$MIX_ENV"

# Run the Reality2 Node
bin/reality2 start
