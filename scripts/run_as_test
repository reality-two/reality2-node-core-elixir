#!/bin/bash

export MIX_ENV=test
export PLUGINS="ai.reality2.vars, ai.reality2.geospatial, ai.reality2.wfs, ai.reality2.backup, ai.reality2.rustdemo, ai.reality2.transnet, ai.reality2.versioncontrol"

# A Reality2 node is unlocked by default. To lock it:
# export LOCKED="true"    # No Sentants or Swarms may be created or deleted after autostart
# export LOCKED="remote"  # Only local API commands can create/delete Swarms or Sentants
export LOCKED="remote"

# Database credentials (override these for your local setup)
export DB_USERNAME="${DB_USERNAME:-postgres}"
export DB_PASSWORD="${DB_PASSWORD:-postgres}"
export DB_HOSTNAME="${DB_HOSTNAME:-localhost}"

# Navigate to project root (resolve symlinks first)
SCRIPT_PATH="$(readlink -f "$0")"
cd "$(dirname "$SCRIPT_PATH")/.."

# Create the mnesia directory structure if it doesn't exist
mkdir -p ".mnesia/$MIX_ENV"

# Get any new deps
mix deps.get

# Force reality2_web to be recompiled in case there have been some new WebApps added
rm -rf "_build/$MIX_ENV/lib/reality2_web"

# Start the Elixir application
iex -S mix phx.server
