# The directory Mix will write compiled artifacts to.
/_build/

#The builds directory contains the compiled artifacts for your project. It is safe to ignore all files in this directory.
/builds/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# files generated by asdf
**/.tool-versions

.elixir_ls

**/__pycache__

mix.lock

/.mnesia/

/.vscode/

/.kdev4/

.node

.DS_Store

# Native library binaries (platform-specific, should be built locally)
*.so

# Hive identity and directory files (contain private keys)
.hive/
.hive_old/

# Trust group identity and directory files (contain private keys)
.r2/

# Stray compiled beam files
*.beam

# Private design documents (kept locally, not tracked)
documents/transnet/v1/
documents/transnet/v2/
